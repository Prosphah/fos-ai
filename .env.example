# Supabase (required for auth + data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role key. Server only, never exposed to the browser.
# Used by the Paystack webhook to write enrollments and invite FOS*AI accounts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Money Mastery Code checkout (Paystack) ---
# Live keys from your Paystack dashboard. sk_test_/pk_test_ for testing.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Absolute origin used for Paystack callbacks. No trailing slash.
NEXT_PUBLIC_SITE_URL=

# Hostname the Money Mastery Code storefront is served from, e.g.
# mmc.betiangli.xyz. Add it to the same Vercel project as the app: src/proxy.ts
# rewrites requests on this host onto the /money-mastery-code routes, so no
# second project or repository is involved. Leave empty to disable rewriting
# and develop against /money-mastery-code/v1 directly.
NEXT_PUBLIC_SALES_HOST=

# Where enrolled buyers watch the lectures. Set this once your Google Drive
# folder is fronted by a custom domain. Only used if you re-enable a direct
# "open your lectures" link; access is currently granted by hand, through the
# WhatsApp or email request button on the success page.
COURSE_ACCESS_URL=

# Your WhatsApp number in international format, digits or +234... . The
# success page composes an access-request message with the buyer's name,
# email and payment reference and opens wa.me with it already typed out.
# Leave empty and the button falls back to a pre-filled email instead.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Purchase confirmation email ---
# Make.com incoming-webhook URL for the scenario that composes and sends the
# confirmation through Zoho. The Paystack webhook POSTs the purchase here.
# Left empty, purchases still complete and no confirmation is attempted.
PURCHASE_EMAIL_WEBHOOK_URL=

# Optional. The API key configured on Make's Webhooks module, sent as the
# x-make-apikey header. A Make custom webhook with any API key added answers
# 401 to a request that does not carry a matching one, so this is required
# whenever a key is set on the module. Make ignores the extra
# X-Purchase-Email-Secret header that is also sent.
PURCHASE_EMAIL_WEBHOOK_SECRET=

# Bearer token guarding /api/cron/*. Required for the resend sweep.
CRON_SECRET=

# Web Push / VAPID (required for push notifications)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Stock Analyzer (AI + Market Data) ---
# Google Gemini API key — required for AI stock explanations.
GOOGLE_AI_API_KEY=

# Kobo Terminal NGX data key — provides P/E ratio for Nigerian stocks.
# Free tier (100 req/day): https://koboterminal.com — key issued instantly.
KOBO_API_KEY=

# Oanor NGX data key — fallback provider with P/E and intraday OHLC.
# https://oanor.com/api/ngx-api
OANOR_API_KEY=

# Finnhub market data key — provides market cap and sector for US stocks.
# Free tier (60 req/min): https://finnhub.io
FINNHUB_API_KEY=

# NGN Market API key — provides 52-week high/low for Nigerian stocks.
# Free tier (3,000 calls/month): https://ngnmarket.com
NGNMARKET_API_KEY=

# Optional: override the default Gemini model (defaults to gemini-3.6-flash).
# Deprecated: gemini-2.0-flash and gemini-2.5-* were retired Sep 2026.
GOOGLE_AI_MODEL=
